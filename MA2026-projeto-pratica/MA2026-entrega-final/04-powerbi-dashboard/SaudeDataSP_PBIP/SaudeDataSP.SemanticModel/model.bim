{
  "name": "SaudeDataSP",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "pt-BR",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "pt-BR",
    "tables": [
      {
        "name": "DimMunicipio",
        "columns": [
          {
            "name": "IBGE6",
            "dataType": "string",
            "isKey": true,
            "sourceColumn": "IBGE6",
            "summarizeBy": "none"
          },
          {
            "name": "IBGE7",
            "dataType": "string",
            "sourceColumn": "IBGE7",
            "summarizeBy": "none"
          },
          {
            "name": "Municipio",
            "dataType": "string",
            "dataCategory": "City",
            "sourceColumn": "Municipio",
            "summarizeBy": "none"
          },
          {
            "name": "Regiao_Comparativa",
            "dataType": "string",
            "sourceColumn": "Regiao_Comparativa",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimMunicipio-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    DadosBase64 = Text.Combine({\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\"\n    }, \"\"),\n    BinarioCSV = Binary.FromText(DadosBase64, BinaryEncoding.Base64),\n    FonteCSV = Csv.Document(BinarioCSV, [Delimiter=\";\", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    CabecalhosPromovidos = Table.PromoteHeaders(FonteCSV, [PromoteAllScalars=true]),\n    LimparTexto = Table.TransformColumns(CabecalhosPromovidos, {\n        {\"IBGE6\", each Text.Trim(Text.Clean(_)), type text},\n        {\"IBGE7\", each Text.Trim(Text.Clean(_)), type text},\n        {\"Municipio\", each Text.Trim(Text.Clean(_)), type text}\n    }),\n    AdicionarRegiao = Table.AddColumn(LimparTexto, \"Regiao_Comparativa\", each if [IBGE6] = \"355030\" then \"Capital (São Paulo)\" else \"Interior (644 Municípios)\", type text),\n    TiposAlterados = Table.TransformColumnTypes(AdicionarRegiao, {{\"IBGE6\", type text}, {\"IBGE7\", type text}, {\"Municipio\", type text}, {\"Regiao_Comparativa\", type text}})\nin\n    TiposAlterados"
            }
          }
        ]
      },
      {
        "name": "FatoMunicipal",
        "columns": [
          {
            "name": "IBGE6",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "IBGE6",
            "summarizeBy": "none"
          },
          {
            "name": "CNES_Cadastrados",
            "dataType": "int64",
            "sourceColumn": "CNES_Cadastrados",
            "formatString": "#,0",
            "summarizeBy": "sum"
          },
          {
            "name": "CNES_Ativos",
            "dataType": "int64",
            "sourceColumn": "CNES_Ativos",
            "formatString": "#,0",
            "summarizeBy": "sum"
          },
          {
            "name": "CNES_Desativados",
            "dataType": "int64",
            "sourceColumn": "CNES_Desativados",
            "formatString": "#,0",
            "summarizeBy": "sum"
          },
          {
            "name": "UBS_Fonte",
            "dataType": "int64",
            "sourceColumn": "UBS_Fonte",
            "formatString": "#,0",
            "summarizeBy": "sum"
          },
          {
            "name": "UBS_Ativas",
            "dataType": "int64",
            "sourceColumn": "UBS_Ativas",
            "formatString": "#,0",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "FatoMunicipal-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    DadosBase64 = Text.Combine({\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\"\n    }, \"\"),\n    BinarioCSV = Binary.FromText(DadosBase64, BinaryEncoding.Base64),\n    FonteCSV = Csv.Document(BinarioCSV, [Delimiter=\";\", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    CabecalhosPromovidos = Table.PromoteHeaders(FonteCSV, [PromoteAllScalars=true]),\n    LimparChave = Table.TransformColumns(CabecalhosPromovidos, {{\"IBGE6\", each Text.Trim(Text.Clean(_)), type text}}),\n    TiposAlterados = Table.TransformColumnTypes(LimparChave, {\n        {\"IBGE6\", type text},\n        {\"CNES_Cadastrados\", Int64.Type},\n        {\"CNES_Ativos\", Int64.Type},\n        {\"CNES_Desativados\", Int64.Type},\n        {\"UBS_Fonte\", Int64.Type},\n        {\"UBS_Ativas\", Int64.Type}\n    })\nin\n    TiposAlterados"
            }
          }
        ]
      },
      {
        "name": "FatoLeitos",
        "columns": [
          {
            "name": "CNES",
            "dataType": "string",
            "sourceColumn": "CNES",
            "summarizeBy": "none"
          },
          {
            "name": "IBGE6",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "IBGE6",
            "summarizeBy": "none"
          },
          {
            "name": "Municipio_Origem",
            "dataType": "string",
            "sourceColumn": "Municipio_Origem",
            "summarizeBy": "none"
          },
          {
            "name": "Estabelecimento",
            "dataType": "string",
            "sourceColumn": "Estabelecimento",
            "summarizeBy": "none"
          },
          {
            "name": "Tipo",
            "dataType": "string",
            "sourceColumn": "Tipo",
            "summarizeBy": "none"
          },
          {
            "name": "Natureza",
            "dataType": "string",
            "sourceColumn": "Natureza",
            "summarizeBy": "none"
          },
          {
            "name": "Leitos_Existentes",
            "dataType": "int64",
            "sourceColumn": "Leitos_Existentes",
            "formatString": "#,0",
            "summarizeBy": "sum"
          },
          {
            "name": "Leitos_SUS",
            "dataType": "int64",
            "sourceColumn": "Leitos_SUS",
            "formatString": "#,0",
            "summarizeBy": "sum"
          },
          {
            "name": "Desabilitacao",
            "dataType": "string",
            "sourceColumn": "Desabilitacao",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "FatoLeitos-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    DadosBase64 = Text.Combine({\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"IFlFUztIT1NQSVRBTCBHRVJBTDtIT1NQSVRBTF9QUklWQURPOzEyMDswOwo=\"\n    }, \"\"),\n    BinarioCSV = Binary.FromText(DadosBase64, BinaryEncoding.Base64),\n    FonteCSV = Csv.Document(BinarioCSV, [Delimiter=\";\", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    CabecalhosPromovidos = Table.PromoteHeaders(FonteCSV, [PromoteAllScalars=true]),\n    PadronizarTexto = Table.TransformColumns(CabecalhosPromovidos, {\n        {\"CNES\", each Text.PadStart(Text.Trim(Text.Clean(_)), 7, \"0\"), type text},\n        {\"IBGE6\", each Text.Trim(Text.Clean(_)), type text},\n        {\"Municipio_Origem\", each Text.Trim(Text.Clean(_)), type text},\n        {\"Estabelecimento\", each Text.Trim(Text.Clean(_)), type text},\n        {\"Tipo\", each Text.Trim(Text.Clean(_)), type text},\n        {\"Natureza\", each Text.Trim(Text.Clean(_)), type text},\n        {\"Desabilitacao\", each Text.Trim(Text.Clean(_)), type text}\n    }),\n    TiposAlterados = Table.TransformColumnTypes(PadronizarTexto, {\n        {\"CNES\", type text},\n        {\"IBGE6\", type text},\n        {\"Municipio_Origem\", type text},\n        {\"Estabelecimento\", type text},\n        {\"Tipo\", type text},\n        {\"Natureza\", type text},\n        {\"Leitos_Existentes\", Int64.Type},\n        {\"Leitos_SUS\", Int64.Type},\n        {\"Desabilitacao\", type text}\n    })\nin\n    TiposAlterados"
            }
          }
        ]
      },
      {
        "name": "_Medidas",
        "columns": [
          {
            "name": "ColunaOculta",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "ColunaOculta",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Estabelecimentos Ativos",
            "expression": "SUM(FatoMunicipal[CNES_Ativos])",
            "formatString": "#,0",
            "description": "Quantidade de estabelecimentos CNES sem motivo de desabilitação (retrato 07/11/2026)."
          },
          {
            "name": "Estabelecimentos Cadastrados",
            "expression": "SUM(FatoMunicipal[CNES_Cadastrados])",
            "formatString": "#,0",
            "description": "Total de estabelecimentos cadastrados no CNES em SP (ativos + desativados)."
          },
          {
            "name": "Estabelecimentos Desativados",
            "expression": "SUM(FatoMunicipal[CNES_Desativados])",
            "formatString": "#,0",
            "description": "Estabelecimentos CNES com motivo de desabilitação preenchido."
          },
          {
            "name": "UBS na Fonte",
            "expression": "SUM(FatoMunicipal[UBS_Fonte])",
            "formatString": "#,0",
            "description": "Total de registros na relação oficial de UBS (07/11/2026)."
          },
          {
            "name": "UBS com CNES Ativo",
            "expression": "SUM(FatoMunicipal[UBS_Ativas])",
            "formatString": "#,0",
            "description": "UBS compatíveis por CNES e município com cadastro ativo no CNES."
          },
          {
            "name": "UBS não Correspondentes ao CNES Ativo",
            "expression": "[UBS na Fonte] - [UBS com CNES Ativo]",
            "formatString": "#,0",
            "description": "Divergência entre a relação de UBS e o cadastro ativo do CNES (510 registros em SP)."
          },
          {
            "name": "Estabelecimentos com Registro de Leitos",
            "expression": "COUNTROWS(FatoLeitos) + 0",
            "formatString": "#,0",
            "description": "Quantidade de estabelecimentos hospitalares com registro de leitos na competência 202609."
          },
          {
            "name": "Leitos Existentes",
            "expression": "SUM(FatoLeitos[Leitos_Existentes])",
            "formatString": "#,0",
            "description": "Total de leitos hospitalares existentes registrados na competência 202609."
          },
          {
            "name": "Leitos SUS",
            "expression": "SUM(FatoLeitos[Leitos_SUS])",
            "formatString": "#,0",
            "description": "Parcela dos leitos existentes destinada ao Sistema Único de Saúde (competência 202609)."
          },
          {
            "name": "Proporção de Leitos SUS",
            "expression": "DIVIDE([Leitos SUS], [Leitos Existentes], 0)",
            "formatString": "0.00%",
            "description": "Razão entre Leitos SUS e Leitos Existentes (não representa taxa de ocupação)."
          },
          {
            "name": "Leitos Não SUS",
            "expression": "[Leitos Existentes] - [Leitos SUS]",
            "formatString": "#,0",
            "description": "Diferença entre leitos existentes e leitos destinados ao SUS."
          },
          {
            "name": "Taxa de Estabelecimentos Ativos",
            "expression": "DIVIDE([Estabelecimentos Ativos], [Estabelecimentos Cadastrados], 0)",
            "formatString": "0.00%",
            "description": "Percentual de estabelecimentos ativos sobre o total cadastrado no CNES."
          },
          {
            "name": "Taxa de Compatibilidade UBS",
            "expression": "DIVIDE([UBS com CNES Ativo], [UBS na Fonte], 0)",
            "formatString": "0.00%",
            "description": "Percentual de UBS com correspondência ativa no CNES."
          },
          {
            "name": "Total de Municípios",
            "expression": "DISTINCTCOUNT(DimMunicipio[IBGE6])",
            "formatString": "#,0",
            "description": "Contagem de municípios paulistas no recorte (645)."
          },
          {
            "name": "Municípios com Leitos Registrados",
            "expression": "DISTINCTCOUNT(FatoLeitos[IBGE6])",
            "formatString": "#,0",
            "description": "Municípios que possuem ao menos um estabelecimento com leitos na competência 202609 (351)."
          },
          {
            "name": "Municípios sem Registro de Leitos",
            "expression": "[Total de Municípios] - [Municípios com Leitos Registrados]",
            "formatString": "#,0",
            "description": "Municípios sem registro de leitos na competência 202609 (294)."
          },
          {
            "name": "Participação Leitos SUS no Estado",
            "expression": "DIVIDE([Leitos SUS], CALCULATE([Leitos SUS], ALL(DimMunicipio)), 0)",
            "formatString": "0.00%",
            "description": "Participação percentual do recorte atual no total de Leitos SUS do Estado de SP."
          }
        ],
        "partitions": [
          {
            "name": "_Medidas-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Fonte = #table(type table [ColunaOculta = text], {{\"Medidas\"}})\nin\n    Fonte"
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "rel_FatoMunicipal_DimMunicipio",
        "fromTable": "FatoMunicipal",
        "fromColumn": "IBGE6",
        "toTable": "DimMunicipio",
        "toColumn": "IBGE6",
        "crossFilteringBehavior": "oneDirection",
        "isActive": true
      },
      {
        "name": "rel_FatoLeitos_DimMunicipio",
        "fromTable": "FatoLeitos",
        "fromColumn": "IBGE6",
        "toTable": "DimMunicipio",
        "toColumn": "IBGE6",
        "crossFilteringBehavior": "oneDirection",
        "isActive": true
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"DimMunicipio\",\"FatoMunicipal\",\"FatoLeitos\",\"_Medidas\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}